# Copier ce fichier en `.env` (dans ce meme dossier scripts/) et remplir avec tes vraies valeurs.
# Ce fichier .env.example est le seul a etre suivi par Git — jamais .env lui-meme.

# URL de l'environnement Dataverse (Parametres > Developpeur > URL de l'API Web dans le Centre d'administration Power Platform)
AIPRP_DATAVERSE_URL=https://votre-org.crm3.dynamics.com

# Domaine ou GUID du tenant Azure AD associe au compte Power Platform
AIPRP_TENANT_ID=votre-tenant.onmicrosoft.com

# ID de l'environnement Dataverse (visible dans le Centre d'administration Power Platform)
AIPRP_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000
